{
  "name": "orcha",
  "version": "0.3.1",
  "private": true,
  "description": "Voir ce que ton dossier .claude déclare, et ce qui charge vraiment.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4300",
    "dev:service": "next dev --hostname localhost --port 4300",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4300",
    "test": "node --test 'lib/**/*.test.ts' 'lib/*.test.ts'",
    "test:hook": "python3 -m unittest discover -p 'test_*.py' -v",
    "empaqueter": "next build && node scripts/empaqueter.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@next/font": "^14.2.15",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azonesbz/orcha.git"
  },
  "homepage": "https://orcha.vincentavz.com"
